{
  "name": "dsh-im-cron",
  "version": "0.1.0",
  "description": "Scheduled notify / script / agent tasks for IM chats — a DeepSeek Harness (DSH) plugin",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "dsh-im", "scheduled-tasks", "cron"],
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./tools": "./tools.js",
    "./agent-settings": "./agent-settings.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "tools.js",
    "client.js",
    "agent-settings.js",
    "config.js",
    "diag.js",
    "core",
    "channel",
    "cli.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "examples"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "croner": "^11.0.1",
    "zod": "^4.6.7",
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
