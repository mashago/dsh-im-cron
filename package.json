{
  "name": "dsh-im-cron",
  "version": "0.3.1",
  "description": "A DeepSeek Harness (DSH) plugin for dsh-im — adds scheduled notify / script / agent tasks to IM chats",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-im",
    "scheduled-tasks",
    "cron"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mashago/dsh-im-cron.git"
  },
  "homepage": "https://github.com/mashago/dsh-im-cron#readme",
  "bugs": {
    "url": "https://github.com/mashago/dsh-im-cron/issues"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.0 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./tools": "./tools.js",
    "./agent-settings": "./agent-settings.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "tools.js",
    "client.js",
    "agent-settings.js",
    "config.js",
    "diag.js",
    "core",
    "channel",
    "cli.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "examples",
    "jobs-view.js",
    "http-api.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "dependencies": {
    "croner": "^11.0.1",
    "zod": "^4.6.7",
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
